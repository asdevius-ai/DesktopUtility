<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopUtility.Host</RootNamespace>
    <AssemblyName>DesktopUtility</AssemblyName>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The DPI settings live in app.manifest (WPF); the WinForms analyzer would rather have them elsewhere. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- Release packaging: one self-contained exe (FFmpeg DLLs and wwwroot stay next to it) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Line numbers in crash logs without shipping a separate .pdb -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global usings to avoid WPF name clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native FFmpeg 6.1 shared libraries used by SIPSorceryMedia.FFmpeg -->
    <Content Include="..\..\third_party\ffmpeg\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Screen capture (DXGI Desktop Duplication) -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />

    <!--
      WebRTC + H.264 encoding.
      NuGet audit flags SIPSorcery 5.2.0 (two denial-of-service advisories: malformed UDP/ICE packet, SCTP SACK parsing).
      It cannot be bumped on its own: SIPSorceryMedia.FFmpeg 1.4.0 is bound to the 5.x API (newer FFmpeg packages need
      FFmpeg 8 DLLs). The SCTP issue is not reachable because no data channel is negotiated; the host is LAN-only.
    -->
    <PackageReference Include="SIPSorcery" Version="5.2.0" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="1.4.0" />

    <!-- Pairing QR code -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
