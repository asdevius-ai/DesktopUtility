<Window x:Class="DesktopUtility.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopUtility.Host.Core"
        xmlns:ctl="clr-namespace:DesktopUtility.Host.Controls"
        Title="DesktopUtility" Width="1000" Height="690" MinWidth="1000" MinHeight="690"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBaseBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">

        <!-- ═══ Ambient background: base gradient → grid → floating light pools ═══ -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.1" RadiusY="1.2">
                    <GradientStop Color="#0A0A0F" Offset="0"/>
                    <GradientStop Color="#050506" Offset="0.5"/>
                    <GradientStop Color="#020203" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" Viewbox="0,0,64,64" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#05FFFFFF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="64,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,64"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid IsHitTestVisible="False">
            <!-- Primary: top centre, accent -->
            <Ellipse Width="900" Height="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-380,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#405E6AD2" Offset="0"/>
                        <GradientStop Color="#185E6AD2" Offset="0.45"/>
                        <GradientStop Color="#005E6AD2" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1Shift"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- Secondary: left, purple / pink -->
            <Ellipse Width="560" Height="700" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-340,60,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#26A855F7" Offset="0"/>
                        <GradientStop Color="#0DA855F7" Offset="0.5"/>
                        <GradientStop Color="#00A855F7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2Shift"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- Tertiary: right, indigo / blue -->
            <Ellipse Width="520" Height="640" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,120,-300,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1F3B82F6" Offset="0"/>
                        <GradientStop Color="#0A3B82F6" Offset="0.5"/>
                        <GradientStop Color="#003B82F6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob3Shift"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- Bottom accent, pulsing -->
            <Ellipse x:Name="BottomPulse" Width="760" Height="300" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-190" Opacity="0.7">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A5E6AD2" Offset="0"/>
                        <GradientStop Color="#005E6AD2" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- ═══ Content ═══ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="5" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#4DFFFFFF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#818CF8" Offset="0"/>
                                <GradientStop Color="#5E6AD2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Width="8" Height="6" CornerRadius="1.5" BorderThickness="1.2" BorderBrush="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DesktopUtility" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource MonoLabel}" FontSize="10"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click">
                        <Path Data="M0,0.5 H10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dashboard -->
            <Grid Grid.Row="1" Margin="28,6,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pairing card -->
                <ctl:SpotlightBorder x:Name="PairCard" Grid.Column="0" CornerRadius="16" Padding="24" BorderThickness="1"
                                     BorderBrush="{StaticResource BorderDefaultBrush}" Background="{StaticResource CardBackgroundBrush}"
                                     Effect="{StaticResource CardShadow}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:T pair.title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource GradientTextBrush}"/>
                        <Border Margin="0,10,0,18" Padding="10,4" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderAccentBrush}"
                                Background="#145E6AD2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusRing" Fill="{StaticResource SuccessBrush}" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale" ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}"/>
                                </Grid>
                                <TextBlock x:Name="StatusText" FontSize="11.5" FontWeight="Medium" Text="{loc:T status.starting}"/>
                            </StackPanel>
                        </Border>

                        <Border Width="212" Height="212" CornerRadius="14" Background="White" Padding="12" HorizontalAlignment="Center"
                                Effect="{StaticResource QrGlow}" Margin="0,0,0,22">
                            <Grid>
                                <Image x:Name="QrCodeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="QrPlaceholder" Text="…" Foreground="#9CA3AF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T pair.pin}" Style="{StaticResource MonoLabel}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PairingPinText" Text="––– –––" FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="SemiBold"
                                   Foreground="{StaticResource GradientTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,18"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderHoverBrush}" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock Text="1" Style="{StaticResource MonoLabel}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{loc:T pair.step1}" Style="{StaticResource BodyMuted}"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderHoverBrush}" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock Text="2" Style="{StaticResource MonoLabel}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{loc:T pair.step2}" Style="{StaticResource BodyMuted}"/>
                        </Grid>

                        <TextBlock x:Name="UrlText" Style="{StaticResource MonoLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NewCodeButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="{loc:T pair.new}" Click="NewCode_Click"/>
                            <Button x:Name="CopyLinkButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{loc:T pair.copy}" Click="CopyLink_Click"/>
                        </Grid>
                    </StackPanel>
                </ctl:SpotlightBorder>

                <!-- Right column -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,2,0">

                        <!-- Devices (hero) -->
                        <ctl:SpotlightBorder x:Name="HeroCard" CornerRadius="16" Padding="26,22" BorderThickness="1" BorderBrush="{StaticResource BorderAccentBrush}"
                                             Effect="{StaticResource CardShadow}" Margin="0,0,0,14">
                            <ctl:SpotlightBorder.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#265E6AD2" Offset="0"/>
                                    <GradientStop Color="#08FFFFFF" Offset="0.6"/>
                                    <GradientStop Color="#04FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </ctl:SpotlightBorder.Background>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="52" Height="52" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderHoverBrush}"
                                        Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                                    <Path Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M-9,-12 H9 A2,2 0 0 1 11,-10 V10 A2,2 0 0 1 9,12 H-9 A2,2 0 0 1 -11,10 V-10 A2,2 0 0 1 -9,-12 Z M-2,8 H2"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{loc:T devices.title}" Style="{StaticResource MonoLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="DevicesCountText" Text="0" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource GradientTextBrush}" LineHeight="48"/>
                                        <TextBlock x:Name="DevicesHintText" Text="{loc:T devices.none}" Style="{StaticResource BodyMuted}" VerticalAlignment="Bottom" Margin="14,0,0,9"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </ctl:SpotlightBorder>

                        <!-- Mode -->
                        <ctl:SpotlightBorder x:Name="ModeCard" CornerRadius="16" Padding="24,20" BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                             Background="{StaticResource CardBackgroundBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{loc:T mode.title}" Style="{StaticResource MonoLabel}" Margin="0,0,0,12"/>
                                <Border CornerRadius="10" Padding="3" Background="#0DFFFFFF" BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="ModeExtendedButton" GroupName="Mode" Style="{StaticResource SegmentButton}" Content="{loc:T mode.extended}" Click="ModeExtended_Click" Margin="0,0,2,0"/>
                                        <RadioButton x:Name="ModeRemoteButton" GroupName="Mode" Style="{StaticResource SegmentButton}" Content="{loc:T mode.remote}" Click="ModeRemote_Click" Margin="2,0,0,0"/>
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="ModeDescriptionText" Style="{StaticResource BodyMuted}" Margin="2,12,0,0"/>
                            </StackPanel>
                        </ctl:SpotlightBorder>

                        <!-- Stream settings -->
                        <ctl:SpotlightBorder x:Name="StreamCard" CornerRadius="16" Padding="24,20" BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                             Background="{StaticResource CardBackgroundBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{loc:T settings.title}" Style="{StaticResource MonoLabel}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T settings.display}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DisplayComboBox" Grid.Column="1" SelectionChanged="DisplayComboBox_SelectionChanged"/>
                                </Grid>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T settings.quality}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="QualityComboBox" Grid.Column="1" SelectionChanged="QualityComboBox_SelectionChanged"/>
                                </Grid>

                                <Rectangle Height="1" Margin="0,0,0,16">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <CheckBox x:Name="StartupCheckbox" Style="{StaticResource ToggleSwitch}" Content="{loc:T settings.startup}"
                                          Checked="StartupCheckbox_Changed" Unchecked="StartupCheckbox_Changed"/>
                            </StackPanel>
                        </ctl:SpotlightBorder>

                        <!-- Diagnostics -->
                        <Expander x:Name="DiagnosticsExpander" Style="{StaticResource ChevronExpander}" Margin="2,0,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T diag.title}" Style="{StaticResource MonoLabel}"/>
                            </Expander.Header>
                            <Border CornerRadius="12" Background="#80000000" BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="14,12" Height="150">
                                <TextBox x:Name="LogsTextBox" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" CaretBrush="Transparent"
                                         SelectionBrush="#805E6AD2"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
